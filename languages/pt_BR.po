# --- SEO ---
#: inc/panel.php:242
msgid "Open Graph Meta Tags"
msgstr "Meta Tags Open Graph"

#: inc/panel.php:242
msgid ""
"Enables the OG Tags system. Generates the necessary tags for social networks (Facebook, "
"Discord, WhatsApp)."
msgstr ""
"Ativa o sistema de OG Tags. Gera as tags necessárias para redes sociais (Facebook, "
"Discord, WhatsApp)."

#: inc/panel.php:243
msgid "Fallback Image (Open Graph)"
msgstr "Imagem de Fallback (Open Graph)"

#: inc/panel.php:243
msgid "Select an image from your library to be the default on social networks."
msgstr "Selecione uma imagem da sua biblioteca para ser o padrão nas redes sociais."

# --- Doações ---
#: inc/panel.php:246
msgid "Donation System"
msgstr "Sistema de Doações"

#: inc/panel.php:247
msgid "Link to your official GitHub sponsorship page for global supporters."
msgstr "Link para a sua página oficial de patrocínio no GitHub para apoiadores globais."

#: inc/panel.php:248
msgid "PayPal Donation Link"
msgstr "Link de Doação PayPal"

#: inc/panel.php:248
msgid "Direct URL to your PayPal donation page."
msgstr "URL direta da sua página de doação do PayPal."

#: inc/panel.php:249
msgid "PayPal QR Code"
msgstr "QR Code do PayPal"

#: inc/panel.php:249
msgid ""
"Upload the PayPal QR Code. When clicked on the site, it will open the link configured "
"above."
msgstr ""
"Upload do QR Code do PayPal. Ao ser clicado no site, ele abrirá o link configurado "
"acima."

#: inc/panel.php:250
msgid "PIX Link (Copy and Paste)"
msgstr "Link do PIX (Copia e Cola)"

#: inc/panel.php:250
msgid ""
"Direct URL for PIX payment (if your bank provides a link). The QR Code will be "
"clickable."
msgstr ""
"URL direta para o pagamento PIX (se o seu banco fornecer link). O QR Code ficará "
"clicável."

#: inc/panel.php:251
msgid "PIX QR Code"
msgstr "QR Code do PIX"

#: inc/panel.php:251
msgid "Upload your PIX QR Code image."
msgstr "Faça o upload da imagem do seu QR Code do PIX."

#: inc/panel.php:252
msgid "PIX Key"
msgstr "Chave PIX"

#: inc/panel.php:252
msgid "email@domain.com or CPF/CNPJ"
msgstr "email@dominio.com.br ou CPF/CNPJ"

#: inc/panel.php:252
msgid "Your direct PIX key for supporters from Brazil."
msgstr "Sua chave PIX direta para apoiadores do Brasil."

# --- ADS ---
#: inc/panel.php:255
msgid "Advertising Zones"
msgstr "Zonas de Publicidade"

#: inc/panel.php:256
msgid "Global Ad Script"
msgstr "Script Global de Anúncios"

#: inc/panel.php:256
msgid "Paste here the global &lt;head&gt; tag (e.g. AdSense Auto Ads)."
msgstr "Cole aqui a tag &lt;head&gt; global (ex: Auto Ads do AdSense)."

#: inc/panel.php:257
msgid "Top Banner - Desktop (728x90)"
msgstr "Banner Topo - Desktop (728x90)"

#: inc/panel.php:257
msgid "Rendered in the header only on large screens (PCs and Laptops)."
msgstr "Renderizado no cabeçalho apenas em telas grandes (PCs e Notebooks)."

#: inc/panel.php:258
msgid "Top Banner - Mobile (320x100)"
msgstr "Banner Topo - Mobile (320x100)"

#: inc/panel.php:258
msgid "Rendered in the header only on smartphone screens."
msgstr "Renderizado no cabeçalho apenas em telas de smartphones."

