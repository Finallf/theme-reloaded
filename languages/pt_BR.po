# --- Seção Geral ---
#: inc/panel.php:189
msgid "Theme Features"
msgstr "Recursos do Tema"

#: inc/panel.php:190
msgid "Back to Top Button"
msgstr "Botão Voltar ao Topo"

#: inc/panel.php:190
msgid ""
"Enables a floating button in the bottom right corner for the user to quickly return to "
"the top of the page."
msgstr ""
"Ativa a exibição de um botão flutuante no canto inferior direito para o usuário "
"retornar rapidamente ao topo da página."

#: inc/panel.php:191
msgid "Enable Top Bar"
msgstr "Ativar Barra de Topo"

#: inc/panel.php:191
msgid "Displays a small bar at the top with date, latest news, and social networks."
msgstr "Exibe uma pequena barra no topo com data, últimas notícias e redes sociais."

#: inc/panel.php:192
msgid "Resize Images"
msgstr "Redimensionar Imagens"

#: inc/panel.php:192
msgid ""
"Enables exact cropping (Hard Crop) of uploaded images to ensure banners and cards are "
"always aligned."
msgstr ""
"Ativa a criação de recortes exatos (Hard Crop) das imagens enviadas para garantir que "
"banners e cards fiquem sempre alinhados."

#: inc/panel.php:193
msgid "Featured Image"
msgstr "Imagem Destacada"

#: inc/panel.php:193
msgid ""
"Adds an option in the post editor sidebar to hide the featured image when reading the "
"article (ideal for posts with videos at the top)."
msgstr ""
"Adiciona uma opção na barra lateral do editor de postagens para ocultar a imagem "
"destacada na leitura do artigo (ideal para posts com vídeos no topo)."

#: inc/panel.php:194
msgid "Image Quality (%)"
msgstr "Qualidade das Imagens (%)"

#: inc/panel.php:194
msgid ""
"Changes image quality. WP default is 82. Lower values make the site faster but reduce "
"visual quality."
msgstr ""
"Altera a qualidade das imagens. O padrão do WP é 82. Valores menores deixam o site mais "
"rápido, mas reduzem a qualidade visual."

#: inc/panel.php:195
msgid "Comment Accessibility"
msgstr "Acessibilidade dos Comentários"

#: inc/panel.php:195
msgid "Adds labels and autocomplete attributes to the comment form."
msgstr ""
"Adiciona labels e atributos de preenchimento automático (autocomplete) ao formulário de "
"comentários."

#: inc/panel.php:196
msgid "Read More Button Text"
msgstr "Texto do botão \"Leia Mais\""

#: inc/panel.php:196
msgid "Ex: Continue Reading &rarr;"
msgstr "Ex: Continuar Lendo &rarr;"

#: inc/panel.php:196
msgid "Customizes the excerpt button text. Leave blank to use the theme default."
msgstr ""
"Personaliza o texto do botão de resumo. Deixe em branco para usar o padrão do tema."

#: inc/panel.php:197
msgid "Comments Separator"
msgstr "Separador de Comentários"

#: inc/panel.php:197
msgid ""
"Text between Author and Post (e.g., \\\"commented on post:\\\").<br>Leave "
"<strong>empty</strong> for WP default or type <strong>&amp;nbsp;</strong> to hide."
msgstr ""
"Texto entre o Autor e o Post (ex: \"comentou no post:\").<br>Deixe <strong>vazio</"
"strong> para o padrão do WP ou digite <strong>&amp;nbsp;</strong> para ocultar."

#: inc/panel.php:198
msgid "Date Format"
msgstr "Formato da Data"

#: inc/panel.php:198
msgid ""
"Ex: l, F j, Y (Returns: Monday, April 29, 2026). <a href=\\\"https://wordpress.org/"
"documentation/article/customize-date-and-time-format/\\\" target=\\\"_blank\\\">See WP "
"documentation</a>."
msgstr ""
"Ex: l, j \\d\\e F \\d\\e Y (Retorna: Segunda-feira, 29 de Abril de 2026). <a "
"href=\"https://wordpress.org/documentation/article/customize-date-and-time-format/\" "
"target=\"_blank\">Ver documentação do WP</a>."

#: inc/panel.php:199
msgid "Views Counter"
msgstr "Contador de Visualizações"

#: inc/panel.php:199
msgid ""
"Enables the post views counting system. A single IP counts only once every 30 minutes. "
"Known bots are automatically ignored."
msgstr ""
"Ativa o sistema de contagem de visualizações por post. Um único IP conta apenas uma vez "
"a cada 30 minutos. Bots conhecidos são ignorados automaticamente."

# --- Busca ---
#: inc/panel.php:202
msgid "Search Page"
msgstr "Página de Busca"

#: inc/panel.php:203
msgid "Grid Layout"
msgstr "Layout Grid"

#: inc/panel.php:203
msgid "Enables Grid layout (Cards side by side)."
msgstr "Habilita o layout de Grid (Cards lado a lado)."

#: inc/panel.php:204
msgid "Vertical List"
msgstr "Lista Vertical"

#: inc/panel.php:204
msgid "Enables Vertical List layout (Large image + excerpt)."
msgstr "Habilita o layout de Lista Vertical (Imagem grande + resumo)."

#: inc/panel.php:205
msgid "Compact List"
msgstr "Lista Compacta"

#: inc/panel.php:205
msgid "Enables Compact layout (Thumbnail + title inline)."
msgstr "Habilita o layout Compacto (Miniatura + título em linha)."

#: inc/panel.php:206
msgid "Google Style"
msgstr "Estilo Google"

#: inc/panel.php:206
msgid "Enables minimalist text-focused layout, similar to search engines."
msgstr "Habilita o layout minimalista focado em texto, similar a motores de busca."

# --- Privacidade ---
#: inc/panel.php:209
msgid "LGPD and Cookies"
msgstr "LGPD e Cookies"

#: inc/panel.php:210
msgid "LGPD - Cookie Banner"
msgstr "LGPD - Banner de Cookies"

#: inc/panel.php:210
msgid "Enables the cookie consent banner in the site footer for legal compliance."
msgstr ""
"Ativa o banner de consentimento de cookies no rodapé do site para conformidade com a "
"lei."

#: inc/panel.php:211
msgid "Cookie Banner Text"
msgstr "Texto do Banner de Cookies"

#: inc/panel.php:211
msgid ""
"Customize the message shown to the user. You can use HTML tags like &lt;a&gt; for links."
msgstr ""
"Personalize a mensagem que aparece para o usuário. Você pode usar tags HTML como "
"&lt;a&gt; para links."

# --- Integrações ---
#: inc/panel.php:214
msgid "Scripts and IDs"
msgstr "Scripts e IDs"

#: inc/panel.php:215
msgid "Google Analytics ID"
msgstr "ID Google Analytics"

#: inc/panel.php:215
msgid "Insert only the tracking code (Tag ID). Leave empty to disable."
msgstr "Insira apenas o código de rastreamento (Tag ID). Deixe vazio para desativar."

#: inc/panel.php:216
msgid "Enable Discord Widget"
msgstr "Ativar Widget do Discord"

#: inc/panel.php:216
msgid "Enables displaying the Discord server in the sidebar."
msgstr "Habilita a exibição do servidor do Discord na barra lateral."

#: inc/panel.php:217
msgid "Discord ID"
msgstr "ID do Discord"

#: inc/panel.php:217
msgid "Server ID to activate communication with the official widget in the sidebar."
msgstr ""
"ID do servidor (Server ID) para ativar a comunicação com o widget oficial na barra "
"lateral."

# --- Performance ---
#: inc/panel.php:220
msgid "Technical Optimization"
msgstr "Otimização Técnica"

#: inc/panel.php:221
msgid "Markdown"
msgstr "Markdown"

#: inc/panel.php:221
msgid ""
"Enables support for Markdown syntax, allowing you to write articles natively (like "
"GitHub or Docker Hub)."
msgstr ""
"Ativa o suporte a sintaxe Markdown, permitindo escrever artigos (como no GitHub ou "
"Docker Hub) nativamente."

#: inc/panel.php:222
msgid "Code Highlight"
msgstr "Destaque de Código"

#: inc/panel.php:222
msgid ""
"Enables Syntax Highlight support, which colors programming codes. It is only loaded on "
"posts for performance."
msgstr ""
"Ativa o suporte a Syntax Highlight, que colore códigos de programação. É carregado "
"apenas em posts para performance."

#: inc/panel.php:223
msgid "Disable Native Emojis"
msgstr "Desativar Emojis Nativos"

#: inc/panel.php:223
msgid ""
"Removes the WP emojis script. Modern browsers already render emojis natively, enable "
"this to save requests."
msgstr ""
"Remove o script de emojis do WP. Navegadores modernos já renderizam emojis nativamente, "
"ative isso para poupar requisições."

#: inc/panel.php:224
msgid "Hide WP Version"
msgstr "Ocultar Versão do WP"

#: inc/panel.php:224
msgid ""
"Removes the WordPress generator meta tag from the source code. A basic security best "
"practice."
msgstr ""
"Remove a meta tag geradora do WordPress do código-fonte. Uma boa prática de segurança "
"básica."

#: inc/panel.php:225
msgid "Security Headers"
msgstr "Headers de Segurança"

#: inc/panel.php:225
msgid ""
"Sends defensive HTTP headers on the frontend (X-Frame-Options, X-Content-Type-Options, "
"Referrer-Policy, Permissions-Policy) to mitigate clickjacking and MIME sniffing. Does "
"not affect the admin panel."
msgstr ""
"Envia headers HTTP defensivos no frontend (X-Frame-Options, X-Content-Type-Options, "
"Referrer-Policy, Permissions-Policy) pra mitigar clickjacking e MIME sniffing. Não "
"afeta o painel admin."

#: inc/panel.php:226
msgid "Facades System"
msgstr "Sistema de Fachadas"

#: inc/panel.php:226
msgid ""
"Replaces heavy iframes (e.g. YouTube) with a lightweight image, loading the player only "
"when the user clicks."
msgstr ""
"Substitui iframes pesados (ex: YouTube) por uma imagem leve, carregando o player apenas "
"quando o usuário clica."

#: inc/panel.php:227
msgid "Disable WP CSS (Bloat)"
msgstr "Desativa o CSS do WP (Bloat)"

#: inc/panel.php:227
msgid ""
"Removes global and block CSS from Gutenberg. Makes the site lighter, ideal for those "
"using Markdown."
msgstr ""
"Remove o CSS global e de blocos do Gutenberg. Deixa o site mais leve, ideal para quem "
"usa Markdown."

