#: inc/panel.php:1719
msgid "In-Article Ad #1"
msgstr ""

#: inc/panel.php:1726
msgid "Ad injected between paragraphs of single posts (not pages). A <strong>fixed 300x250</strong> rectangle is recommended — compact, high demand, and a predictable height for the reserved space below (zero layout shift). Leave empty to disable. CSP nonce and lazy-load are applied automatically."
msgstr ""

#: inc/panel.php:1731
msgid "Insert after paragraph #"
msgstr ""

#: inc/panel.php:1738
msgid "The ad goes right after this top-level paragraph (paragraphs inside quotes/lists/code are skipped). Avoid 1 — Google penalizes ads above the content. Default: 4. The ad only appears if the post has at least one paragraph after this one."
msgstr ""

#: inc/panel.php:1743
msgid "Reserved height (px)"
msgstr ""

#: inc/panel.php:1752
msgid "Min-height reserved for the slot <strong>before the ad loads</strong> = zero layout shift (CLS). Match it to the ad size + label: a 300x250 wants ~290-300. Default: 300. Use 0 to reserve nothing (not recommended)."
msgstr ""

#: inc/panel.php:1757
msgid "In-Article Ad #2 (long articles)"
msgstr ""

#: inc/panel.php:1764
msgid "Optional second zone, deeper in the article. Only appears when the post is long enough to reach the paragraph below — short posts keep a single ad. Leave empty to disable."
msgstr ""

#: inc/panel.php:1769
msgid "Insert #2 after paragraph #"
msgstr ""

#: inc/panel.php:1776
msgid "Set this deep (e.g. 10-12) so the second ad only shows on long reads. Default: 10."
msgstr ""

#: inc/panel.php:1781
msgid "Reserved height #2 (px)"
msgstr ""

#: inc/panel.php:1790
msgid "Reserved height for the second zone. Default: 300."
msgstr ""

