msgid "Compact List"
msgstr ""

#: inc/panel.php:577
msgid "Enables Compact layout (Thumbnail + title inline). <strong>Note:</strong> Compact also acts as a safety net — if the visitor disables every chip on the frontend, all results fall back here regardless of this setting."
msgstr ""

#: inc/panel.php:582
msgid "Google Style"
msgstr ""

#: inc/panel.php:589
msgid "Enables minimalist text-focused layout, similar to search engines."
msgstr ""

